#!/usr/bin/env bash
#
# Health check for this setup. Read-only -- never changes anything.
#
#   bin/doctor          human-readable report
#
# Exit code: 0 if nothing failed, 1 if any FAIL. Warnings do not fail.
#
# Each check exists because that failure actually happened or is silent:
# a dangling out-of-store symlink, an untrusted nix user quietly losing the
# binary cache, a shell that prints errors on every start.

set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

PASS=0 WARN=0 FAIL=0
ok() { printf '  \033[32m✓\033[0m %-34s %s\n' "$1" "${2:-}"; PASS=$((PASS + 1)); }
warn() { printf '  \033[33m!\033[0m %-34s %s\n' "$1" "${2:-}"; WARN=$((WARN + 1)); }
bad() { printf '  \033[31m✗\033[0m %-34s %s\n' "$1" "${2:-}"; FAIL=$((FAIL + 1)); }
hdr() { printf '\n\033[1m%s\033[0m\n' "$1"; }

################################################################################
hdr "repo"
################################################################################
[[ "$REPO" == "$HOME/Develop/configs" ]] &&
  ok "location" "$REPO" ||
  bad "location" "expected ~/Develop/configs, dotfile symlinks will dangle"

hooks=$(git config --local --get core.hooksPath 2>/dev/null)
[[ "$hooks" == "hooks" ]] &&
  ok "git hooks" "core.hooksPath=hooks" ||
  bad "git hooks" "not wired; 'git pull' will not apply changes (run setup.sh)"

head=$(git rev-parse HEAD 2>/dev/null)
synced=$(cat .git/last-synced 2>/dev/null)
if [[ -z "$synced" ]]; then
  warn "applied" "never synced; run setup.sh"
elif [[ "$head" == "$synced" ]]; then
  ok "applied" "up to date (${head:0:7})"
else
  behind=$(git rev-list --count "$synced..$head" 2>/dev/null || echo "?")
  bad "applied" "$behind commit(s) unapplied; run bin/sync --force"
fi

if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
  warn "working tree" "uncommitted changes (bin/sync --force to apply them)"
else
  ok "working tree" "clean"
fi

################################################################################
hdr "nix"
################################################################################
command -v nix >/dev/null 2>&1 &&
  ok "nix" "$(nix --version 2>/dev/null)" ||
  bad "nix" "not installed"

command -v darwin-rebuild >/dev/null 2>&1 &&
  ok "nix-darwin" "$(cat /run/current-system/darwin-version 2>/dev/null)" ||
  bad "nix-darwin" "darwin-rebuild not found"

# The silent one: nix.enable=false makes nix-darwin delete a nix.conf it used
# to manage, taking trusted-users with it. Builds keep working, they just stop
# hitting the cache.
if [[ -f /etc/nix/nix.conf ]]; then
  ok "/etc/nix/nix.conf" "present"
else
  bad "/etc/nix/nix.conf" "missing; restore from /etc/nix/nix.conf.pre-configs"
fi

trusted=$(nix config show trusted-users 2>/dev/null)
if grep -qE "(@admin|\\b$USER\\b)" <<<"$trusted"; then
  ok "trusted user" "$trusted"
else
  bad "trusted user" "'$trusted' -- your substituters/netrc are being IGNORED"
fi

subs=$(nix config show substituters 2>/dev/null | tr ' ' '\n' | grep -c . || echo 0)
[[ "$subs" -gt 1 ]] &&
  ok "substituters" "$subs configured" ||
  warn "substituters" "only $subs; builds may compile from source"

################################################################################
hdr "packages"
################################################################################
P="/etc/profiles/per-user/$USER/bin"
missing=""
for t in git gh zsh tmux k9s kubectl bat jq direnv; do
  [[ -x "$P/$t" ]] || missing+="$t "
done
[[ -z "$missing" ]] &&
  ok "nix packages" "all present" ||
  bad "nix packages" "missing: $missing"

fonts=$(find "$HOME/Library/Fonts/HomeManager" -name '*.ttf' 2>/dev/null | wc -l | tr -d ' ')
[[ "$fonts" -gt 0 ]] &&
  ok "nerd font" "$fonts files (p10k needs one)" ||
  bad "nerd font" "none; powerlevel10k will render tofu boxes"

if [[ -x /opt/homebrew/bin/brew ]]; then
  ok "homebrew" "$(/opt/homebrew/bin/brew --version 2>/dev/null | head -1)"
  casks=$(nix eval --raw "$REPO#darwinConfigurations.default.config.homebrew.casks" \
    --apply 'cs: builtins.concatStringsSep " " (map (c: c.name) cs)' 2>/dev/null)
  for c in $casks; do
    /opt/homebrew/bin/brew list --cask "$c" >/dev/null 2>&1 &&
      ok "  cask $c" "installed" ||
      bad "  cask $c" "declared but not installed (run setup.sh)"
  done
else
  bad "homebrew" "not installed; declared casks cannot be applied"
fi

################################################################################
hdr "dotfiles"
################################################################################
# mkOutOfStoreSymlink points into this working copy; if a target is renamed or
# the repo moves, the link dangles silently.
for f in .gitconfig .gitignore_global .p10k.zsh .zshrc \
  .config/cmux/cmux.json .config/ghostty .claude/settings.json .claude/CLAUDE.md; do
  t="$HOME/$f"
  if [[ -L "$t" && -e "$t" ]]; then
    ok "$f" "linked"
  elif [[ -L "$t" ]]; then
    bad "$f" "DANGLING symlink -> $(readlink "$t")"
  elif [[ -e "$t" ]]; then
    warn "$f" "regular file, not managed (sync not yet run?)"
  else
    bad "$f" "absent"
  fi
done

# The ghostty config references shaders/; without them the terminal errors.
shader=$(grep -oE 'custom-shader = *[^ ]+' "$HOME/.config/ghostty/config" 2>/dev/null | awk '{print $3}')
if [[ -n "$shader" ]]; then
  [[ -e "$HOME/.config/ghostty/$shader" ]] &&
    ok "ghostty shader" "$shader resolves" ||
    bad "ghostty shader" "$shader MISSING"
fi

################################################################################
hdr "agents"
################################################################################
if [[ -x "$HOME/.local/bin/claude" ]]; then
  ok "claude code" "$("$HOME/.local/bin/claude" --version 2>/dev/null)"
else
  bad "claude code" "not installed"
fi

[[ -x /opt/homebrew/bin/cmux ]] &&
  ok "cmux cli" "$(/opt/homebrew/bin/cmux version 2>/dev/null | head -1)" ||
  warn "cmux cli" "not found (cask provides it)"

# Anything beyond the two managed files would mean credentials/history got
# swept into the repo.
leaked=$(cd "$REPO" && git ls-files dotfiles/claude | grep -vcE 'settings\.json|CLAUDE\.md' || true)
[[ "${leaked:-0}" -eq 0 ]] &&
  ok "claude config scope" "only settings.json + CLAUDE.md tracked" ||
  bad "claude config scope" "$leaked unexpected file(s) tracked under dotfiles/claude"

################################################################################
hdr "shell"
################################################################################
noise=$(zsh -i -c exit 2>&1 | grep -vcE '^\s*$' || true)
[[ "${noise:-0}" -eq 0 ]] &&
  ok "startup output" "clean" ||
  warn "startup output" "$noise line(s) on stderr; run: zsh -i -c exit"

ms=$( { TIMEFORMAT=%R; time zsh -i -c exit >/dev/null 2>&1; } 2>&1 |
  awk '{printf "%.0f", $1*1000}')
if [[ -n "$ms" && "$ms" -lt 500 ]]; then
  ok "startup time" "${ms}ms"
else
  warn "startup time" "${ms}ms (>500ms; consider fewer plugins)"
fi

################################################################################
hdr "freshness"
################################################################################
locked=$(git log -1 --format=%cr -- flake.lock 2>/dev/null)
ok "flake.lock" "last updated $locked  (bin/update to refresh)"

printf '\n\033[1m%d passed, %d warning(s), %d failed\033[0m\n' "$PASS" "$WARN" "$FAIL"
[[ "$FAIL" -eq 0 ]] || {
  echo "run ./setup.sh to repair, or see the message next to each ✗"
  exit 1
}
