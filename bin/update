#!/usr/bin/env bash
#
# Update the things this repo pins. Nothing here happens automatically --
# `git pull` applies config *changes*, it does not move versions.
#
#   bin/update           update nix packages (flake.lock) and apply
#   bin/update --casks   also upgrade Homebrew casks
#   bin/update --dry     show what would change, apply nothing
#
# Not covered, on purpose:
#   Claude Code   self-updates; see setup.sh for why it is not pinned
#   hand-installed apps   their own updaters

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

say() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!!  %s\033[0m\n' "$*"; }

CASKS=false
DRY=false
for a in "$@"; do
  case "$a" in
  --casks) CASKS=true ;;
  --dry) DRY=true ;;
  *)
    warn "unknown option: $a"
    exit 1
    ;;
  esac
done

say "nix inputs"
if [[ "$DRY" == true ]]; then
  # --dry-run still reports what would move without writing flake.lock.
  nix flake update --dry-run 2>&1 | grep -E 'Updated|Added|Removed' || echo "  nothing to update"
else
  before=$(git rev-parse HEAD:flake.lock 2>/dev/null || echo none)
  nix flake update
  after=$(git hash-object flake.lock)
  if [[ "$before" == "$after" ]]; then
    echo "  flake.lock unchanged"
  else
    echo "  flake.lock changed -- commit it to share the update with your other machines"
  fi
fi

if [[ "$CASKS" == true ]]; then
  say "homebrew casks"
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    list=$(nix eval --raw "$REPO#darwinConfigurations.default.config.homebrew.casks" \
      --apply 'cs: builtins.concatStringsSep " " (map (c: c.name) cs)' 2>/dev/null)
    if [[ "$DRY" == true ]]; then
      brew outdated --cask --greedy $list || true
    else
      brew upgrade --cask $list || warn "one or more casks failed to upgrade"
    fi
  else
    warn "homebrew not installed"
  fi
fi

if [[ "$DRY" == true ]]; then
  say "dry run -- nothing applied"
  exit 0
fi

say "applying"
"$REPO/bin/sync" --force

say "done"
echo "  run bin/doctor to confirm everything still looks right"
